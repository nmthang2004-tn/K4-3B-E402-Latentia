# ==========================================
# Trợ lý Discord (K4-3B Latentia) - Config
# Tác giả: Nguyễn Minh Tuấn (2A202602420)
# ==========================================

# 1. Discord Bot Credentials
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=
TA_ROLE_NAME=@TA

# 2. AI Model Provider (gemini / openai)
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback theo thứ tự, ngăn cách bằng dấu phẩy
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-flash-latest

# OpenAI API Key (Dự phòng)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Model Parameters
AI_TEMPERATURE=0.0
AI_MAX_OUTPUT_TOKENS=1000
AI_THINKING_BUDGET=0
